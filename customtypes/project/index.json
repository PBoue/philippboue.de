{
  "id": "project",
  "label": "Project",
  "format": "custom",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Project Name",
          "placeholder": "Project Name"
        }
      },
      "excerpt": {
        "type": "StructuredText",
        "config": {
          "label": "Excerpt",
          "placeholder": "Project Excerpt",
          "allowTargetBlank": true,
          "multi": "paragraph,hyperlink"
        }
      },
      "screenshot": {
        "type": "Image",
        "config": {
          "label": "Screenshot",
          "constraint": {},
          "thumbnails": []
        }
      },
      "link": {
        "type": "Link",
        "config": {
          "label": "Link",
          "placeholder": "Link to project",
          "allowTargetBlank": false,
          "select": null
        }
      },
      "company_name": {
        "type": "Text",
        "config": {
          "label": "Company Name",
          "placeholder": ""
        }
      },
      "companylogo": {
        "type": "Image",
        "config": {
          "label": "CompanyLogo",
          "constraint": {},
          "thumbnails": []
        }
      },
      "industry": {
        "type": "Select",
        "config": {
          "label": "Industry",
          "placeholder": "",
          "options": [
            "Agency",
            "Media & Publishers",
            "Retail & Consumer Goods",
            "Finance & Insurance",
            "Mobility",
            "Travel",
            "Telco",
            "Software",
            "Energy"
          ]
        }
      },
      "country": {
        "type": "Select",
        "config": {
          "label": "Country",
          "placeholder": "",
          "options": [
            "Germany",
            "England",
            "Spain",
            "United States",
            "Netherlands",
            "Belgium",
            "France",
            "Luxemburg"
          ],
          "default_value": "Germany"
        }
      },
      "client": {
        "type": "StructuredText",
        "config": {
          "label": "Client",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "employer": {
        "type": "Select",
        "config": {
          "label": "Employer",
          "placeholder": "Chose employer",
          "options": [
            "Freelanced",
            "Sevenval AG (now Avenga)",
            "YOC AG",
            "ubiiqu GmbH",
            "Kalaydo GmbH & Co. KG (now markt.de)",
            "people interactive GmbH (now Valtech)",
            "Valtech GmbH",
            "Alpha Neun GmbH & Co. KG",
            "P.Digital",
            "Kircher Burkhardt GmbH (now C3)"
          ]
        }
      },
      "role": {
        "type": "Select",
        "config": {
          "label": "Role",
          "placeholder": "Chose",
          "options": [
            "Chose",
            "Project Manager",
            "Product Owner",
            "Senior Manager Business Development",
            "UX/UI Designer",
            "Frontend-Developer",
            "Strategy Consultant",
            "Head of Product",
            "Creative Director",
            "Executive Creative Director",
            "Managing Director"
          ]
        }
      },
      "management": {
        "type": "Number",
        "config": {
          "label": "Management",
          "placeholder": ""
        }
      },
      "design": {
        "type": "Number",
        "config": {
          "label": "Design",
          "placeholder": ""
        }
      },
      "code": {
        "type": "Number",
        "config": {
          "label": "Code",
          "placeholder": ""
        }
      },
      "startdate": {
        "type": "Date",
        "config": {
          "label": "Startdate",
          "placeholder": ""
        }
      },
      "enddate": {
        "type": "Date",
        "config": {
          "label": "Enddate",
          "placeholder": ""
        }
      }
    }
  }
}
