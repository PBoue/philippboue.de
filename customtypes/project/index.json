{
  "id": "project",
  "label": "Project",
  "format": "custom",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Project Name",
          "placeholder": "Project Name"
        }
      },
      "company_name": {
        "type": "Text",
        "config": {
          "label": "Company Name",
          "placeholder": ""
        }
      },
      "logo": {
        "type": "Select",
        "config": {
          "label": "Logo",
          "placeholder": "",
          "options": [
            "actimonda",
            "adidas",
            "alphaneun",
            "antena3",
            "axa",
            "bmg",
            "congstar",
            "coremedia",
            "deutschebahn",
            "deutschepost",
            "deutschetelekom",
            "dailytelegraph"
          ]
        }
      },
      "excerpt": {
        "type": "StructuredText",
        "config": {
          "label": "Excerpt",
          "placeholder": "Project Excerpt",
          "allowTargetBlank": true,
          "multi": "paragraph,hyperlink"
        }
      },
      "link": {
        "type": "Link",
        "config": {
          "label": "Link",
          "placeholder": "Link to project",
          "allowTargetBlank": false,
          "select": null
        }
      },
      "screenshot": {
        "type": "Image",
        "config": {
          "label": "Screenshot",
          "constraint": {},
          "thumbnails": []
        }
      },
      "startdate": {
        "type": "Date",
        "config": {
          "label": "Startdate",
          "placeholder": ""
        }
      },
      "enddate": {
        "type": "Date",
        "config": {
          "label": "Enddate",
          "placeholder": ""
        }
      },
      "management": {
        "type": "Number",
        "config": {
          "label": "Management",
          "placeholder": ""
        }
      },
      "design": {
        "type": "Number",
        "config": {
          "label": "Design",
          "placeholder": ""
        }
      },
      "code": {
        "type": "Number",
        "config": {
          "label": "Code",
          "placeholder": ""
        }
      },
      "client": {
        "type": "StructuredText",
        "config": {
          "label": "Client",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "paragraph,strong,em,hyperlink"
        }
      },
      "country": {
        "type": "Select",
        "config": {
          "label": "Country",
          "placeholder": "",
          "options": [
            "Germany",
            "England",
            "Spain",
            "United States",
            "Netherlands",
            "Belgium",
            "France",
            "Luxemburg"
          ],
          "default_value": "Germany"
        }
      },
      "industry": {
        "type": "Select",
        "config": {
          "label": "Industry",
          "placeholder": "",
          "options": [
            "Agency",
            "Media & Publishers",
            "Retail & Consumer Goods",
            "Finance & Insurance",
            "Mobility",
            "Travel",
            "Telco",
            "Software"
          ]
        }
      }
    }
  }
}
